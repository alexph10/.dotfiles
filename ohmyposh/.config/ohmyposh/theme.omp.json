{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "version": 2,
    "final_space": true,
    "console_title_template": "{{ .Folder }}",
    "palette": {
        "bg":      "#1a1b26",
        "fg":      "#c0caf5",
        "blue":    "#7aa2f7",
        "cyan":    "#7dcfff",
        "green":   "#9ece6a",
        "magenta": "#bb9af7",
        "red":     "#f7768e",
        "orange":  "#ff9e64",
        "yellow":  "#e0af68",
        "gray":    "#414868"
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "type": "os",
                    "style": "diamond",
                    "leading_diamond": "\ue0b6",
                    "trailing_diamond": "\ue0b0",
                    "foreground": "p:bg",
                    "background": "p:blue",
                    "template": " {{ if .WSL }}WSL {{ end }}{{ .Icon }} "
                },
                {
                    "type": "session",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "foreground": "p:bg",
                    "background": "p:cyan",
                    "template": " {{ .UserName }} "
                },
                {
                    "type": "path",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "foreground": "p:bg",
                    "background": "p:magenta",
                    "properties": {
                        "style": "agnoster_short",
                        "max_depth": 3,
                        "folder_icon": "\uf07b",
                        "home_icon": "~"
                    },
                    "template": " {{ .Path }} "
                },
                {
                    "type": "git",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b0",
                    "foreground": "p:bg",
                    "background": "p:green",
                    "background_templates": [
                        "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
                        "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
                        "{{ if gt .Ahead 0 }}p:orange{{ end }}",
                        "{{ if gt .Behind 0 }}p:cyan{{ end }}"
                    ],
                    "properties": {
                        "branch_icon": "\ue725 ",
                        "fetch_status": true,
                        "fetch_upstream_icon": true
                    },
                    "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} "
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "right",
            "segments": [
                {
                    "type": "node",
                    "style": "plain",
                    "foreground": "p:green",
                    "template": " \ue718 {{ .Full }} ",
                    "properties": { "fetch_version": true, "display_mode": "files" }
                },
                {
                    "type": "python",
                    "style": "plain",
                    "foreground": "p:yellow",
                    "template": " \ue235 {{ .Full }} ",
                    "properties": { "fetch_version": true, "display_mode": "files" }
                },
                {
                    "type": "go",
                    "style": "plain",
                    "foreground": "p:cyan",
                    "template": " \ufcd1 {{ .Full }} ",
                    "properties": { "fetch_version": true, "display_mode": "files" }
                },
                {
                    "type": "rust",
                    "style": "plain",
                    "foreground": "p:orange",
                    "template": " \ue7a8 {{ .Full }} ",
                    "properties": { "fetch_version": true, "display_mode": "files" }
                },
                {
                    "type": "executiontime",
                    "style": "plain",
                    "foreground": "p:gray",
                    "template": " \uf252 {{ .FormattedMs }} ",
                    "properties": { "threshold": 500, "style": "round" }
                },
                {
                    "type": "time",
                    "style": "plain",
                    "foreground": "p:gray",
                    "template": " {{ .CurrentDate | date \"15:04:05\" }} "
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "status",
                    "style": "plain",
                    "foreground": "p:green",
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}p:red{{ end }}"
                    ],
                    "properties": { "always_enabled": true },
                    "template": "{{ if gt .Code 0 }}\uf00d {{ .Code }} {{ else }}\u276f {{ end }}"
                }
            ]
        }
    ]
}

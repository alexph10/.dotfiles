{{- /*
  chezmoi run_once hook (Windows). The hash of this template is part of the chezmoi state;
  it re-runs only when the embedded manifest content changes.
*/ -}}
{{- if eq .chezmoi.os "windows" -}}
#requires -Version 7.0
$ErrorActionPreference = 'Continue'

$manifestHash = @'
{{ include "../packages/winget.json" }}
'@
$scoopHash = @'
{{ include "../packages/scoop.txt" }}
'@
$null = $manifestHash; $null = $scoopHash

$repoScript = Join-Path {{ .chezmoi.sourceDir | quote }} '..' 'scripts' 'install-packages.ps1'
if (-not (Test-Path $repoScript)) {
    Write-Warning "install-packages.ps1 not found at $repoScript; skipping."
    return
}

Write-Host "==> Running $repoScript" -ForegroundColor Cyan
& pwsh -NoLogo -NoProfile -File $repoScript {{ if not .installLanguages }} -SkipMise{{ end }}
{{- end -}}

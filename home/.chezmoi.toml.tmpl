{{- /* chezmoi config template: prompts on `chezmoi init` and persists answers into .config/chezmoi/chezmoi.toml */ -}}
{{- $name        := promptStringOnce . "name" "Full name (for git)" "Alex Y" -}}
{{- $email       := promptStringOnce . "email" "Email (for git)" "alex@example.com" -}}
{{- $machineKind := promptChoiceOnce . "machineKind" "Machine kind" (list "personal" "work" "server") "personal" -}}
{{- $useSigning  := promptBoolOnce  . "useSigning" "Enable git commit signing?" false -}}
{{- $installFonts := promptBoolOnce . "installFonts" "Install Nerd Fonts during bootstrap?" true -}}
{{- $installLangs := promptBoolOnce . "installLanguages" "Install language toolchains (node, python, go, rust) via mise?" true -}}

encryption = "age"

[data]
    name             = {{ $name | quote }}
    email            = {{ $email | quote }}
    machineKind      = {{ $machineKind | quote }}
    work             = {{ eq $machineKind "work" }}
    useSigning       = {{ $useSigning }}
    installFonts     = {{ $installFonts }}
    installLanguages = {{ $installLangs }}

[diff]
    pager = "delta"

[merge]
    command = "nvim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]

[git]
    autoCommit = false
    autoPush   = false

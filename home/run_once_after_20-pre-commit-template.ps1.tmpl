{{- if and .autoPreCommit (eq .chezmoi.os "windows") -}}
#requires -Version 7.0
$ErrorActionPreference = 'Continue'
if (-not (Get-Command pre-commit -ErrorAction SilentlyContinue)) {
    Write-Warning 'pre-commit not installed; skipping template dir setup.'
    return
}
$tpl = Join-Path $HOME '.git-template'
New-Item -ItemType Directory -Force -Path $tpl | Out-Null
pre-commit init-templatedir $tpl | Out-Null
Write-Host "Installed pre-commit template at $tpl (used by new git init/clone)." -ForegroundColor Green
{{- end -}}

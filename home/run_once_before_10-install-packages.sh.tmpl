{{- /*
  chezmoi run_once hook (POSIX). Re-runs only when the manifest content changes.
*/ -}}
{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

# embed manifest content so chezmoi re-runs this script when it changes
: <<'MANIFEST'
{{ include "../packages/brew.txt" }}
{{ include "../packages/apt.txt" }}
MANIFEST

REPO_SCRIPT="{{ .chezmoi.sourceDir }}/../scripts/install-packages.sh"
if [ ! -f "$REPO_SCRIPT" ]; then
    echo "install-packages.sh not found at $REPO_SCRIPT; skipping." >&2
    exit 0
fi
echo "==> Running $REPO_SCRIPT"
bash "$REPO_SCRIPT"
{{- end -}}

{{- if and .autoPreCommit (ne .chezmoi.os "windows") -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit not installed; skipping template dir setup." >&2
    exit 0
fi

mkdir -p "$HOME/.git-template"
pre-commit init-templatedir "$HOME/.git-template" >/dev/null
echo "Installed pre-commit template at $HOME/.git-template (used by new git init/clone)."
{{- end -}}

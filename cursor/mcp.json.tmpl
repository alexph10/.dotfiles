{
    "mcpServers": {
        "filesystem": {
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-filesystem", {{ .chezmoi.homeDir | quote }}],
            "type": "stdio"
        },
        "git": {
            "command": "uvx",
            "args": ["mcp-server-git"],
            "type": "stdio"
        },
        "fetch": {
            "command": "uvx",
            "args": ["mcp-server-fetch"],
            "type": "stdio"
        }
{{- if eq .machineKind "work" }},
        "github": {
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-github"],
            "type": "stdio",
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ env "GITHUB_TOKEN" }}"
            }
        }
{{- end }}
    }
}
